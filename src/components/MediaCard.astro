---
import type { MediaOutlet } from '../lib/data';
import { getCategoryGroupId } from '../lib/data';
import StatusBadge from './StatusBadge.astro';

interface Props {
  media: MediaOutlet;
  /** When false, status badge is hidden but data-status remains for filtering */
  showStatus?: boolean;
}

const { media, showStatus = false } = Astro.props;

/** Soft status tint — subtle marker so cards are easier to scan */
const statusSurface: Record<MediaOutlet['status'], string> = {
  verified: 'bg-white border-brand-dark/8',
  unverified: 'bg-zinc-100/90 border-brand-dark/10',
  review: 'bg-amber-50/90 border-amber-200/60',
  suspended: 'bg-rose-50/90 border-rose-200/50',
};

/** Display hostname only, e.g. https://www.kompas.com → kompas.com */
function displayDomain(domain: string) {
  try {
    const host = new URL(domain.startsWith('http') ? domain : `https://${domain}`).hostname;
    return host.replace(/^www\./, '');
  } catch {
    return domain.replace(/^https?:\/\//, '').replace(/^www\./, '').split('/')[0];
  }
}

const domainLabel = displayDomain(media.domain);
const avatarLabel = domainLabel.slice(0, 2).toUpperCase();
const categoryGroup = getCategoryGroupId(media.type);
---

<article
  class:list={[
    'media-card group relative flex flex-row items-center gap-3 border p-3 transition hover:border-brand-primary/25 hover:shadow-[0_12px_40px_-20px_rgba(76,29,149,0.35)] sm:h-full sm:flex-col sm:items-stretch sm:gap-0 sm:p-5',
    showStatus ? statusSurface[media.status] : 'bg-white border-brand-dark/8',
  ]}
  data-name={media.name.toLowerCase()}
  data-domain={domainLabel.toLowerCase()}
  data-type={media.type}
  data-category-group={categoryGroup}
  data-province={media.address.province}
  data-city={media.address.city}
  data-status={media.status}
  data-categories={(media.categories || []).join(',').toLowerCase()}
>
  <!-- Logo / avatar -->
  <div class="flex shrink-0 items-start justify-between gap-2 sm:w-full">
    {media.logo ? (
      <div class="flex h-8 w-8 items-center justify-center sm:h-9 sm:w-auto sm:max-w-[120px] sm:justify-start">
        <img
          src={media.logo}
          alt={media.name}
          class="h-full w-auto max-w-full object-contain object-left mix-blend-multiply"
        />
      </div>
    ) : (
      <div
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-primary/8 font-display text-xs font-bold text-brand-primary sm:h-11 sm:w-11 sm:rounded-xl sm:text-sm"
        aria-hidden="true"
      >
        {avatarLabel}
      </div>
    )}
    {showStatus && (
      <div class="hidden sm:block">
        <StatusBadge status={media.status} />
      </div>
    )}
  </div>

  <!-- Text -->
  <div class="min-w-0 flex-1 sm:mt-4 sm:flex sm:flex-1 sm:flex-col">
    <div class="flex items-start justify-between gap-2">
      <h3 class="truncate font-display text-sm font-bold tracking-tight text-brand-dark sm:text-lg">
        <a href={`/directory/${media.slug}`} class="hover:text-brand-light after:absolute after:inset-0">
          {domainLabel}
        </a>
      </h3>
      {showStatus && (
        <div class="shrink-0 sm:hidden">
          <StatusBadge status={media.status} size="sm" />
        </div>
      )}
    </div>

    <p class="mt-0.5 truncate text-[11px] font-medium text-brand-dark/50 sm:mt-1 sm:flex-1 sm:text-xs sm:whitespace-normal">
      {media.type} · {media.address.city}, {media.address.province}
    </p>

    <!-- Desktop footer link -->
    <div class="mt-5 hidden border-t border-brand-dark/6 pt-4 text-right text-xs sm:block">
      <span class="relative z-10 font-semibold text-brand-primary transition group-hover:text-brand-light">
        Lihat profil →
      </span>
    </div>
  </div>

  <!-- Mobile chevron -->
  <span
    class="relative z-10 shrink-0 text-brand-primary/50 sm:hidden"
    aria-hidden="true"
  >
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </span>
</article>
